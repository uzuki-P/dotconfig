[Unit]
Description=Private Gokapi upload notifications
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/binwiederhier/ntfy:v2.28.0
ContainerName=ntfy-gokapi
PublishPort=127.0.0.1:53843:8080
Volume=%h/docker/ntfy/data:/var/lib/ntfy:Z
EnvironmentFile=%h/docker/ntfy/.env
Environment=NTFY_LISTEN_HTTP=:8080
Environment=NTFY_CACHE_FILE=/var/lib/ntfy/cache.db
Environment=NTFY_AUTH_FILE=/var/lib/ntfy/auth.db
Environment=NTFY_AUTH_DEFAULT_ACCESS=deny-all
Environment=NTFY_BEHIND_PROXY=true
Environment=NTFY_ENABLE_LOGIN=true
Exec=serve
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180

[Install]
WantedBy=default.target

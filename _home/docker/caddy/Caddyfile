{
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

(service) {
	@{args[0]} host {args[0]}.{$CADDY_TS_BASE_DOMAIN:ts.example.com}
	handle @{args[0]} {
		reverse_proxy {args[1]}
	}
}

# Keep the automatic HTTP redirect private as well as the HTTPS listener.
http://*.{$CADDY_TS_BASE_DOMAIN:ts.example.com} {
	bind 127.0.0.1 {$CADDY_TS_IP:127.0.0.1}
	redir https://{host}{uri} 308
}

*.{$CADDY_TS_BASE_DOMAIN:ts.example.com} {
	# The private wildcard is reachable from this host and the tailnet only.
	bind 127.0.0.1 {$CADDY_TS_IP:127.0.0.1}

	# Gokapi's authenticated admin page is the upload entry point. The public
	# index otherwise redirects to the configured informational URL.
	@files_root {
		host files.{$CADDY_TS_BASE_DOMAIN:ts.example.com}
		path /
	}
	handle @files_root {
		redir https://{host}/admin 302
	}

	# Advanced routes that cannot be represented by `dev-route set`.
	# ttyd (Herdr web terminal) is the generated named route `herdr` -> 127.0.0.1:7681.
	@draw host draw.{$CADDY_TS_BASE_DOMAIN:ts.example.com}
	handle @draw {
		redir http://100.122.109.76:3729{uri} 302
	}

	# Persistent and ephemeral routes generated by the dev-route CLI.
	import /etc/caddy/dev-routes/*.caddy

	respond 404
}

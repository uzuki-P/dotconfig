# List the available dev-router commands.
default:
    @just --list

# Initialize persistent routes and apply them to Caddy.
setup:
    ./dev-router.sh setup

# Validate route state and the generated Caddy fragment.
validate:
    ./dev-router.sh validate

# Reapply persistent routes to the running Caddy instance.
apply:
    ./dev-router.sh apply

# Show currently published routes.
status:
    ./dev-router.sh status

# List the available dev-router commands.
default:
    @just --list

# Initialize persistent routes and apply them to Caddy.
setup:
    ./dev-router.sh setup

# Publish a random dev-<hex> route for a localhost port or URL.
random target:
    ./dev-router.sh random {{target}}

# Set a persistent named localhost route through Caddy's admin API.
specific name target:
    ./dev-router.sh specific {{name}} {{target}}

# List persistent named localhost routes.
list-named:
    ./dev-router.sh list-named

# Remove a persistent named localhost route through Caddy's admin API.
[confirm("Remove persistent route '" + name + "'?")]
remove-specific name:
    ./dev-router.sh remove-specific {{name}}

# Validate route state and the generated Caddy fragment.
validate:
    ./dev-router.sh validate

# Reapply persistent routes to the running Caddy instance.
apply:
    ./dev-router.sh apply

# Show currently published routes.
status:
    ./dev-router.sh status

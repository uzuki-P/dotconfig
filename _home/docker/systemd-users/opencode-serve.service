[Unit]
Description=Headless opencode server (OpenCode REST API on loopback)
After=network.target

[Service]
EnvironmentFile=%h/.config/opencode/serve.env
ExecStart=/home/uzuki_p/.opencode/bin/opencode serve --hostname 127.0.0.1 --port 4096
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

# Copy to ~/.config/opencode/serve.env and fill in the password:
#   install -Dm600 /dev/null ~/.config/opencode/serve.env
#
# Generate a value with:
#   openssl rand -base64 32
#
# This file is read by opencode-serve.service via EnvironmentFile.
# Keep it out of version control; only the .example belongs in dotconfig.
OPENCODE_SERVER_PASSWORD=change-me

# Local API traffic stays on loopback.
GOKAPI_API_URL=http://127.0.0.1:53842

# Stable private URL printed by bin/share. Do not commit the real tailnet domain.
GOKAPI_PUBLIC_URL=https://files.<your-dev-router-domain>

# Optional override. The default is ./secrets/api-key.
# GOKAPI_API_KEY_FILE=/home/your-user/docker/files/secrets/api-key

# Optional notification publishing. Keep tokens and device endpoints private.
# NTFY_URL=https://ntfy.<your-dev-router-domain>/gokapi-uploads
# NTFY_TOKEN_FILE=/home/your-user/docker/files/secrets/ntfy-token
# NTFY_ENDPOINTS_FILE=/home/your-user/docker/files/secrets/ntfy-endpoints

# Optional public API relay for gokapi-android (docs/relay.md). just relay-setup
# fills these in. They are not secret, but keep the domain and IDs out of git.
# RELAY_DOMAIN=files-api.<a-zone-on-your-cloudflare-account>
# RELAY_TUNNEL_ID=<tunnel-uuid>
# RELAY_VPC_SERVICE_ID=<vpc-service-uuid>
# RELAY_KV_NAMESPACE_ID=<kv-namespace-id>
# Optional overrides. The defaults are shown. Set CLOUDFLARE_ACCOUNT_ID if
# wrangler can see more than one account.
# WRANGLER="npx -y wrangler@4.156.0"
# GOKAPI_ADMIN_API_KEY_FILE=/home/your-user/docker/files/secrets/admin-api-key

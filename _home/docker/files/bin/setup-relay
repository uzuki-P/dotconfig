#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  Most stages run wrangler for you. Stages 2 and 4 need the browser,\n' "$DIM"
  printf '  for a Gokapi admin key and a tunnel API token. Stop any time with\n'
  printf '  Ctrl-C and re-run later; it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────


TOTAL_STAGES=10

PROJECT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_DIR"
ENV_FILE="$PROJECT_DIR/.env"
WRANGLER="${WRANGLER:-npx -y wrangler@4.156.0}"
read -r -a WRANGLER_CMD <<<"$WRANGLER"
UUID_RE='[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'

# write_secret FILE VALUE stores a secret with mode 0600, never in .env.
write_secret() {
  install -d -m 0700 "$(dirname "$1")"
  (umask 077 && printf '%s' "$2" > "$1")
  chmod 0600 "$1"
  printf '  %s✓ wrote%s %s (mode 0600)\n' "$GREEN" "$RESET" "$1"
}

# run_capture VAR CMD... runs CMD, shows its output, and keeps it in VAR.
run_capture() {
  local var="$1" out
  shift
  out=$("$@" 2>&1 | tee /dev/stderr) || { warn "failed: $*"; exit 1; }
  printf -v "$var" '%s' "$out"
}

# zone_of HOST prints the Cloudflare zone on wrangler's account that holds HOST.
# The OAuth token stays in a variable and reaches curl through stdin.
zone_of() {
  local host="$1" token candidate count
  token=$("${WRANGLER_CMD[@]}" auth token --json 2>/dev/null | jq -r '.token // empty') || return 1
  [[ -n "$token" ]] || return 1
  candidate="$host"
  while :; do
    count=$(printf 'Authorization: Bearer %s\n' "$token" \
      | curl --silent --fail --header @- "https://api.cloudflare.com/client/v4/zones?name=${candidate}" \
      | jq -r '.result | length') || return 1
    if [[ "$count" -gt 0 ]]; then printf '%s' "$candidate"; return 0; fi
    [[ "$candidate" == *.*.* ]] || return 1
    candidate="${candidate#*.}"
  done
}

banner "Gokapi relay (Worker + Workers VPC + Cloudflare Tunnel)"

# ── 1 ─────────────────────────────────────────────────────────────────────
stage "Check prerequisites and the wrangler login"
say "The relay publishes only the API gokapi-android calls, through a Worker."
say "Read docs/relay.md first if you haven't."
MISSING=""
for tool in node npx curl jq podman just; do
  if command -v "$tool" >/dev/null 2>&1; then note "found $tool"; else warn "missing $tool"; MISSING=1; fi
done
[[ -z "$MISSING" ]] || { warn "Install the missing tools, then run this again."; exit 1; }
GOKAPI_PUBLIC_URL=$(_existing GOKAPI_PUBLIC_URL || true)
[[ "$GOKAPI_PUBLIC_URL" == https://* ]] || { warn "Set GOKAPI_PUBLIC_URL in .env first (see README)."; exit 1; }
curl --silent --fail --output /dev/null http://127.0.0.1:53842/ \
  || { warn "Gokapi isn't answering on 127.0.0.1:53842; run just start first."; exit 1; }
note "Gokapi answers on 127.0.0.1:53842."
if ! "${WRANGLER_CMD[@]}" whoami --json >/dev/null 2>&1; then
  say "wrangler isn't logged in. It opens a browser to authorize."
  pause "Press Enter to run: npx wrangler login"
  "${WRANGLER_CMD[@]}" login
fi
"${WRANGLER_CMD[@]}" whoami --json | jq -r '"  account: " + (.accounts[] | .name + " (" + .id + ")")'
pause "Is that the account to use? Press Enter to continue (Ctrl-C to stop)."

# ── 2 ─────────────────────────────────────────────────────────────────────
stage "Gokapi admin key for bin/pair"
if [[ -s secrets/admin-api-key ]] && ! confirm "secrets/admin-api-key exists. Replace it"; then
  note "Keeping secrets/admin-api-key."
else
  say "bin/pair creates each device's limited Gokapi key through this one."
  open_url "$GOKAPI_PUBLIC_URL/apiKeys"
  step "In Gokapi's API menu, create a new key and name it pair-admin."
  step "Grant only API management (Manage API keys); revoke every other permission."
  step "Copy the key."
  ask_secret GOKAPI_ADMIN_KEY_VALUE "Paste the Gokapi admin key:"
  [[ -n "$GOKAPI_ADMIN_KEY_VALUE" ]] && write_secret secrets/admin-api-key "$GOKAPI_ADMIN_KEY_VALUE"
  unset GOKAPI_ADMIN_KEY_VALUE
fi
pause

# ── 3 ─────────────────────────────────────────────────────────────────────
stage "Relay domain"
say "Pick a hostname for the relay Worker, such as files-api.example.com."
note "Its zone must be on this Cloudflare account. Keep it outside the"
note "*.<CADDY_TS_BASE_DOMAIN> wildcard, which points at the tailnet."
ask RELAY_DOMAIN "Relay hostname (no https://):"
RELAY_DOMAIN="${RELAY_DOMAIN#https://}"
RELAY_DOMAIN="${RELAY_DOMAIN%/}"
[[ "$RELAY_DOMAIN" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ && "$RELAY_DOMAIN" == *.* ]] \
  || { warn "Expected a lowercase hostname such as files-api.example.com."; exit 1; }
if ZONE=$(zone_of "$RELAY_DOMAIN"); then
  note "Found zone $ZONE on the account."
else
  warn "Couldn't find a zone for $RELAY_DOMAIN on this account."
  confirm "Continue anyway" || exit 1
fi
write_env RELAY_DOMAIN "$RELAY_DOMAIN"
pause

# ── 4 ─────────────────────────────────────────────────────────────────────
stage "Create the tunnel"
RELAY_TUNNEL_ID=$(_existing RELAY_TUNNEL_ID || true)
if [[ -n "$RELAY_TUNNEL_ID" ]]; then
  note "RELAY_TUNNEL_ID is already set: $RELAY_TUNNEL_ID"
else
  if [[ ! -s secrets/cf-tunnel-api-token ]]; then
    say "wrangler's login can't manage tunnels, so tunnel commands need an API token."
    open_url "https://dash.cloudflare.com/profile/api-tokens"
    step "Create Token, then Create Custom Token. Name it gokapi-relay-tunnel."
    step "Permissions: Account > Cloudflare Tunnel > Edit. Nothing else."
    step "Account Resources: Include your account. Create it and copy the token."
    ask_secret CF_TUNNEL_API_TOKEN_VALUE "Paste the API token:"
    [[ -n "$CF_TUNNEL_API_TOKEN_VALUE" ]] || { warn "No token entered."; exit 1; }
    write_secret secrets/cf-tunnel-api-token "$CF_TUNNEL_API_TOKEN_VALUE"
    unset CF_TUNNEL_API_TOKEN_VALUE
  fi
  say "Creates a remotely managed tunnel named gokapi-relay. It gets no public"
  say "hostname and no ingress rules; only the Worker's VPC binding uses it."
  confirm "Run just relay-tunnel" || exit 1
  run_capture OUT just relay-tunnel
  RELAY_TUNNEL_ID=$(grep -oE "ID: $UUID_RE" <<<"$OUT" | head -n1 | cut -d' ' -f2)
  [[ -n "$RELAY_TUNNEL_ID" ]] || { warn "Couldn't read the tunnel ID from the output."; exit 1; }
  write_env RELAY_TUNNEL_ID "$RELAY_TUNNEL_ID"
fi
pause

# ── 5 ─────────────────────────────────────────────────────────────────────
stage "Save the tunnel token"
if [[ -s secrets/tunnel-token ]] && ! confirm "secrets/tunnel-token exists. Fetch it again"; then
  note "Keeping secrets/tunnel-token."
else
  say "Fetches the token cloudflared runs the tunnel with into secrets/tunnel-token."
  RELAY_TUNNEL_ID="$RELAY_TUNNEL_ID" just relay-tunnel-token
fi
pause

# ── 6 ─────────────────────────────────────────────────────────────────────
stage "Register Gokapi as a VPC service"
RELAY_VPC_SERVICE_ID=$(_existing RELAY_VPC_SERVICE_ID || true)
if [[ -n "$RELAY_VPC_SERVICE_ID" ]]; then
  note "RELAY_VPC_SERVICE_ID is already set: $RELAY_VPC_SERVICE_ID"
else
  say "Creates a Workers VPC service: HTTP to 127.0.0.1:53842 through the tunnel."
  confirm "Run just relay-vpc" || exit 1
  run_capture OUT just relay-vpc
  RELAY_VPC_SERVICE_ID=$(grep -oE "Created VPC service: $UUID_RE" <<<"$OUT" | head -n1 | awk '{print $NF}')
  [[ -n "$RELAY_VPC_SERVICE_ID" ]] || { warn "Couldn't read the VPC service ID from the output."; exit 1; }
  write_env RELAY_VPC_SERVICE_ID "$RELAY_VPC_SERVICE_ID"
fi
pause

# ── 7 ─────────────────────────────────────────────────────────────────────
stage "Create the device KV namespace"
RELAY_KV_NAMESPACE_ID=$(_existing RELAY_KV_NAMESPACE_ID || true)
if [[ -n "$RELAY_KV_NAMESPACE_ID" ]]; then
  note "RELAY_KV_NAMESPACE_ID is already set: $RELAY_KV_NAMESPACE_ID"
else
  say "Creates the KV namespace that holds each paired device's secret hash."
  confirm "Run just relay-kv" || exit 1
  run_capture OUT just relay-kv
  RELAY_KV_NAMESPACE_ID=$(grep -oE '"id": "[0-9a-f]{32}"' <<<"$OUT" | head -n1 | grep -oE '[0-9a-f]{32}')
  [[ -n "$RELAY_KV_NAMESPACE_ID" ]] || { warn "Couldn't read the namespace ID from the output."; exit 1; }
  write_env RELAY_KV_NAMESPACE_ID "$RELAY_KV_NAMESPACE_ID"
fi
pause

# ── 8 ─────────────────────────────────────────────────────────────────────
stage "Deploy the relay Worker"
say "Runs the Worker tests, writes relay/wrangler.jsonc from .env, and deploys"
say "the Worker on the custom domain $RELAY_DOMAIN."
confirm "Run just relay-deploy" || exit 1
just relay-deploy
pause

# ── 9 ─────────────────────────────────────────────────────────────────────
stage "Install and start the tunnel"
say "Installs the rootless cloudflared Quadlet and starts it."
if confirm "Run just tunnel-install and just tunnel-start"; then
  just tunnel-install
  just tunnel-start
  sleep 5
  systemctl --user --no-pager status cloudflared.service | sed -n '1,5p' || true
else
  SKIPPED+=("just tunnel-install && just tunnel-start")
fi
pause

# ── 10 ────────────────────────────────────────────────────────────────────
stage "Check the relay and pair a device"
just relay-smoke || warn "The relay should answer 401 without credentials. Check: just relay-logs"
say "Next, for each device:"
step "just pair <device>   (prints a pairing link and QR code)"
step "Open the link on that device only."
step "From mobile data, run the checks in docs/relay.md (Verification)."
SKIPPED+=("just pair <device> for each device, then the docs/relay.md verification table")
pause

finish

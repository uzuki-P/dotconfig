[Unit]
Description=Cloudflare Tunnel connecting the Gokapi relay Worker to Gokapi
Wants=network-online.target gokapi.service
After=network-online.target gokapi.service

[Container]
Image=docker.io/cloudflare/cloudflared:2026.10.7
ContainerName=gokapi-cloudflared
# Gokapi publishes only on the host's 127.0.0.1:53842. Rootless pasta gives the
# container its own network namespace; -T 53842 forwards the container's
# loopback port 53842 to the host's loopback port 53842 and nothing else. The
# tunnel's outbound connections use pasta's normal NAT. This is narrower than
# Network=host, which would let a compromised cloudflared, or a route added to
# this remotely managed tunnel, reach every host loopback service.
Network=pasta:-T,53842
# The image runs as 65532. keep-id maps the host user to that UID, so the
# user-owned mode 0600 token file stays readable inside.
UserNS=keep-id:uid=65532,gid=65532
# The tunnel is remotely managed and has no public hostname; only the relay
# Worker's VPC service binding reaches Gokapi through it. The token is read
# from a file so it never appears in the container's environment, argv, or
# podman inspect output.
Volume=%h/docker/files/secrets/tunnel-token:/run/secrets/tunnel-token:ro,Z
Exec=tunnel --no-autoupdate run --token-file /run/secrets/tunnel-token
ReadOnly=true
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180

[Install]
WantedBy=default.target

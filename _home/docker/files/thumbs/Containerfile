# gokapi-thumbs: built locally by `just thumbs-build`; see ../docs/thumbnails.md.
FROM docker.io/library/python:3.13.18-slim
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --no-compile -r /app/requirements.txt \
 && useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin thumbs
COPY server.py /app/server.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 THUMBS_CACHE_DIR=/cache
USER 10001:10001
EXPOSE 53845
ENTRYPOINT ["python", "/app/server.py"]

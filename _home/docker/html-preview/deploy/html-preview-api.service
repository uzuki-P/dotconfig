[Unit]
Description=Private HTML preview write API
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 %h/.agents/skills/publish-html/scripts/html_preview.py serve --bind 127.0.0.1 --port 4179
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target

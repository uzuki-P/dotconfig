{
	admin off
	auto_https off
}

:8080 {
	root * /srv

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Revalidate every response (cheap with ETags) so a sync that rewrites
		# published pages to new asset versions reaches browsers immediately.
		Cache-Control "no-cache"
	}

	@health path /healthz
	respond @health "ok" 200

	@archived path /.archive /.archive/*
	respond @archived 404

	@api path /api/*
	reverse_proxy @api host.containers.internal:4179

	file_server {
		hide /.archive
	}
}

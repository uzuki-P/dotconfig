# Show the available HTML preview commands.
default:
    @just --list

# Synchronize shared browser assets and refresh the document index.
prepare:
    python3 ../../.codex/skills/html-response/scripts/html_preview.py sync

# Serve the preview directory on loopback without Podman.
dev: prepare
    python3 -m http.server 4178 --bind 127.0.0.1 --directory public

# Validate the publisher, index page, assets, Caddyfile, and Quadlet definition.
validate:
    python3 ../../.codex/skills/html-response/scripts/html_preview.py self-test
    node --check ../../.codex/skills/html-response/assets/document.js
    xmllint --noout ../../.codex/skills/html-response/assets/favicon.svg
    @grep -q '^Image=docker.io/library/caddy:2.11.4-alpine$' deploy/html-preview.container
    @grep -q '^PublishPort=127.0.0.1:4178:8080$' deploy/html-preview.container
    @grep -q '^ReadOnly=true$' deploy/html-preview.container
    @grep -q '^NoNewPrivileges=true$' deploy/html-preview.container
    @grep -q '^DropCapability=all$' deploy/html-preview.container
    @grep -q '^AddCapability=NET_BIND_SERVICE$' deploy/html-preview.container
    @echo "Static validation passed."

# Install the rootless Quadlet and prepare the document directory.
install: prepare
    install -d -m 0700 "${HOME}/.config/containers/systemd"
    install -m 0644 deploy/html-preview.container "${HOME}/.config/containers/systemd/html-preview.container"
    systemctl --user daemon-reload

# Install and start the private preview service.
setup: install
    systemctl --user start html-preview.service

# Show the user service and loopback listener status.
status:
    systemctl --user --no-pager --full status html-preview.service
    @ss -ltn '( sport = :4178 )' || true

# Follow recent preview-service logs.
logs:
    journalctl --user-unit html-preview.service --follow --lines=100

# Stop the service while preserving published documents.
stop:
    systemctl --user stop html-preview.service

# Create or refresh the persistent private Tailscale route.
route:
    cd ../dev-router && just specific html-preview 4178

# Publish an HTML file through the skill's deterministic CLI.
publish file *args:
    python3 ../../.codex/skills/html-response/scripts/html_preview.py publish {{file}} {{args}}

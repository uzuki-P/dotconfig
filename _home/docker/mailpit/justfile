# List the available Mailpit commands.
default:
    @just --list

# Install the rootless Quadlets and start Mailpit.
setup: install
    systemctl --user start mailpit.service

# Validate the tracked Quadlet definitions.
validate:
    @grep -q '^Image=docker.io/axllent/mailpit:latest$' deploy/mailpit.container
    @grep -q '^PublishPort=127.0.0.1:1025:1025$' deploy/mailpit.container
    @grep -q '^PublishPort=127.0.0.1:8025:8025$' deploy/mailpit.container
    @grep -q '^NetworkName=mailpit$' deploy/mailpit.network
    @grep -q '^VolumeName=mailpit-data$' deploy/mailpit-data.volume
    @echo "Static validation passed."

# Install the rootless user Quadlets and reload user systemd.
install:
    install -d -m 0700 "${HOME}/.config/containers/systemd"
    install -m 0644 deploy/mailpit.container "${HOME}/.config/containers/systemd/mailpit.container"
    install -m 0644 deploy/mailpit.network "${HOME}/.config/containers/systemd/mailpit.network"
    install -m 0644 deploy/mailpit-data.volume "${HOME}/.config/containers/systemd/mailpit-data.volume"
    systemctl --user daemon-reload

# Show Mailpit container status.
status:
    systemctl --user --no-pager --full status mailpit.service
    @ss -ltn '( sport = :1025 or sport = :8025 )' || true

# Follow recent Mailpit logs.
logs:
    journalctl --user-unit mailpit.service --follow --lines=100

# Stop Mailpit while preserving captured messages.
stop:
    systemctl --user stop mailpit.service

# Pull the current image and restart Mailpit.
update:
    podman pull docker.io/axllent/mailpit:latest
    systemctl --user restart mailpit.service

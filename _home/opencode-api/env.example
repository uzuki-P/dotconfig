# Copy to ~/.config/opencode-api/env (done by `just setup`, which also fills
# random keys). All values optional; defaults live in the shim script.

# Bearer key required from OpenAI-compatible clients (OpenWhispr custom provider).
SHIM_API_KEY=

# Bearer key the shim presents to the opencode server (OPENCODE_SERVER_PASSWORD).
OPENCODE_SERVER_PASSWORD=

# Defaults for model resolution and behaviour.
#OC_BASE_URL=http://127.0.0.1:14096
#OC_DEFAULT_PROVIDER=zai-coding-plan
#OC_DEFAULT_MODEL=glm-4.7
#OC_AGENT=plan
#OC_WAIT_TIMEOUT=120
#SHIM_PORT=14097

#!/usr/bin/env python3
"""Manage private, random tailnet hostnames for localhost development servers."""

from __future__ import annotations

import argparse
import datetime as dt
import ipaddress
import json
import os
from pathlib import Path
import re
import secrets
import sys
import tempfile
from urllib import error, request
from urllib.parse import urlparse


ID_PATTERN = re.compile(r"^dev-[a-f0-9]{8}$")
DOMAIN_PATTERN = re.compile(
    r"^(?=.{1,253}\.?$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+"
    r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
)


def install_home() -> Path:
    return Path(__file__).resolve().parents[2]


def state_dir() -> Path:
    override = os.environ.get("DEV_ROUTE_STATE_DIR")
    return Path(override).expanduser() if override else install_home() / "docker/dev-router/.data"


def caddyfile_path() -> Path:
    override = os.environ.get("DEV_ROUTE_CADDYFILE")
    return Path(override).expanduser() if override else install_home() / "docker/caddy/Caddyfile"


def paths() -> tuple[Path, Path, Path]:
    root = state_dir()
    return root / "settings.json", root / "routes.json", root / "routes.caddy"


def read_json(path: Path, default: object) -> object:
    if not path.exists():
        return default
    with path.open(encoding="utf-8") as handle:
        return json.load(handle)


def atomic_bytes(path: Path, value: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(value)
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def atomic_json(path: Path, value: object) -> None:
    encoded = (json.dumps(value, indent=2, sort_keys=True) + "\n").encode()
    atomic_bytes(path, encoded)


def snapshot(paths_to_save: tuple[Path, ...]) -> dict[Path, bytes | None]:
    return {path: path.read_bytes() if path.exists() else None for path in paths_to_save}


def restore(saved: dict[Path, bytes | None]) -> None:
    for path, value in saved.items():
        if value is None:
            path.unlink(missing_ok=True)
        else:
            atomic_bytes(path, value)


def parse_env_value(path: Path, key: str) -> str | None:
    if not path.exists():
        return None
    prefix = f"{key}="
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if line.startswith(prefix):
            return line[len(prefix) :].strip().strip("'\"")
    return None


def normalize_domain(value: str) -> str:
    domain = value.strip().lower().rstrip(".")
    if not DOMAIN_PATTERN.fullmatch(domain):
        raise ValueError(f"invalid base domain: {value!r}")
    return domain


def load_settings() -> dict[str, str]:
    settings_path, _, _ = paths()
    settings = read_json(settings_path, {})
    if not isinstance(settings, dict) or "base_domain" not in settings:
        raise RuntimeError("dev router is not initialized; run dev-route init --base-domain <domain>")
    return {"base_domain": normalize_domain(str(settings["base_domain"]))}


def load_routes() -> dict[str, dict[str, str]]:
    _, routes_path, _ = paths()
    routes = read_json(routes_path, {})
    if not isinstance(routes, dict):
        raise RuntimeError(f"invalid route registry: {routes_path}")
    return routes


def render(routes: dict[str, dict[str, str]]) -> str:
    lines = ["# Generated by dev-route. Do not edit."]
    for route_id, route in sorted(routes.items()):
        lines.append(f"import service {route_id} {route['target']}")
    return "\n".join(lines) + "\n"


def write_routes(routes: dict[str, dict[str, str]]) -> None:
    _, routes_path, fragment_path = paths()
    atomic_json(routes_path, routes)
    atomic_bytes(fragment_path, render(routes).encode())


def apply_caddy() -> None:
    caddyfile = caddyfile_path()
    if not caddyfile.is_file():
        raise RuntimeError(f"Caddyfile not found: {caddyfile}")
    endpoint = os.environ.get("DEV_ROUTE_CADDY_ADMIN", "http://127.0.0.1:2019").rstrip("/")
    load_request = request.Request(
        f"{endpoint}/load",
        data=caddyfile.read_bytes(),
        headers={"Content-Type": "text/caddyfile"},
        method="POST",
    )
    try:
        with request.urlopen(load_request, timeout=10) as response:
            if not 200 <= response.status < 300:
                raise RuntimeError(f"Caddy rejected the configuration: HTTP {response.status}")
    except error.HTTPError as exc:
        detail = exc.read().decode(errors="replace").strip()
        raise RuntimeError(f"Caddy rejected the configuration: HTTP {exc.code}: {detail}") from exc
    except error.URLError as exc:
        raise RuntimeError(f"Caddy admin API is unavailable at {endpoint}: {exc.reason}") from exc


def persist_and_apply(
    routes: dict[str, dict[str, str]],
    *,
    settings: dict[str, str] | None = None,
    no_apply: bool = False,
) -> None:
    settings_path, routes_path, fragment_path = paths()
    saved = snapshot((settings_path, routes_path, fragment_path))
    try:
        if settings is not None:
            atomic_json(settings_path, settings)
        write_routes(routes)
        if not no_apply:
            apply_caddy()
    except Exception:
        restore(saved)
        raise


def normalize_target(raw: str) -> str:
    candidate = raw if "://" in raw else f"http://127.0.0.1:{raw}"
    parsed = urlparse(candidate)
    try:
        port = parsed.port
    except ValueError as exc:
        raise ValueError("target port must be a number between 1 and 65535") from exc
    if parsed.scheme not in {"http", "https"} or not parsed.hostname or not port:
        raise ValueError("target must be a port or an http(s) URL with an explicit port")
    if parsed.path not in {"", "/"} or parsed.params or parsed.query or parsed.fragment:
        raise ValueError("target must not include a path, query, or fragment")
    host = parsed.hostname
    try:
        is_loopback = ipaddress.ip_address(host).is_loopback
    except ValueError:
        is_loopback = host == "localhost"
    if not is_loopback:
        raise ValueError("target host must be localhost, 127.0.0.0/8, or ::1")
    rendered_host = f"[{host}]" if ":" in host else host
    return f"{parsed.scheme}://{rendered_host}:{port}"


def route_id_from(value: str, base_domain: str) -> str:
    candidate = value.strip().lower().rstrip("/")
    if "://" in candidate:
        candidate = urlparse(candidate).hostname or ""
    suffix = f".{base_domain}"
    if candidate.endswith(suffix):
        candidate = candidate[: -len(suffix)]
    if not ID_PATTERN.fullmatch(candidate):
        raise ValueError(f"expected dev-<8 hex characters>, got {value!r}")
    return candidate


def command_init(args: argparse.Namespace) -> None:
    domain = args.base_domain
    if args.from_env_file:
        domain = domain or parse_env_value(Path(args.from_env_file), "CADDY_TS_BASE_DOMAIN")
    domain = domain or os.environ.get("DEV_ROUTE_BASE_DOMAIN") or "ts.example.com"
    normalized = normalize_domain(domain)
    routes = load_routes()
    persist_and_apply(routes, settings={"base_domain": normalized}, no_apply=args.no_apply)
    suffix = " without applying it" if args.no_apply else " and applied it to Caddy"
    print(f"Initialized dev router for *.{normalized}{suffix}")


def command_publish(args: argparse.Namespace) -> None:
    settings = load_settings()
    routes = load_routes()
    target = normalize_target(args.target)
    for _ in range(32):
        route_id = f"dev-{secrets.token_hex(4)}"
        if route_id not in routes:
            break
    else:
        raise RuntimeError("could not allocate a unique route id")
    routes[route_id] = {
        "target": target,
        "created_at": dt.datetime.now(dt.timezone.utc).isoformat(),
        "cwd": str(Path.cwd()),
    }
    persist_and_apply(routes, no_apply=args.no_apply)
    print(f"https://{route_id}.{settings['base_domain']}")


def command_list(_args: argparse.Namespace) -> None:
    settings = load_settings()
    routes = load_routes()
    if not routes:
        print("No published dev routes.")
        return
    for route_id, route in sorted(routes.items()):
        print(f"https://{route_id}.{settings['base_domain']}\t{route['target']}\t{route.get('cwd', '-')}")


def command_resolve(args: argparse.Namespace) -> None:
    settings = load_settings()
    route_id = route_id_from(args.route, settings["base_domain"])
    routes = load_routes()
    if route_id not in routes:
        raise KeyError(f"unknown route: {route_id}")
    route = routes[route_id]
    print(json.dumps({
        "id": route_id,
        "url": f"https://{route_id}.{settings['base_domain']}",
        **route,
    }, indent=2, sort_keys=True))


def command_remove(args: argparse.Namespace) -> None:
    settings = load_settings()
    route_id = route_id_from(args.route, settings["base_domain"])
    routes = load_routes()
    if route_id not in routes:
        raise KeyError(f"unknown route: {route_id}")
    removed = routes.pop(route_id)
    persist_and_apply(routes, no_apply=args.no_apply)
    print(f"Removed https://{route_id}.{settings['base_domain']} -> {removed['target']}")


def command_apply(_args: argparse.Namespace) -> None:
    command_validate(_args)
    apply_caddy()
    print("Applied persistent dev routes to Caddy.")


def command_validate(_args: argparse.Namespace) -> None:
    settings = load_settings()
    routes = load_routes()
    for route_id, route in routes.items():
        if not ID_PATTERN.fullmatch(route_id):
            raise ValueError(f"invalid route id in registry: {route_id!r}")
        normalize_target(route["target"])
    _, _, fragment_path = paths()
    actual = fragment_path.read_text(encoding="utf-8") if fragment_path.exists() else None
    if actual != render(routes):
        raise RuntimeError(f"generated fragment is stale: run dev-route init; file={fragment_path}")
    print(f"Valid: {len(routes)} route(s) for *.{settings['base_domain']}")


def add_no_apply(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--no-apply", action="store_true", help=argparse.SUPPRESS)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    init = commands.add_parser("init", help="initialize settings and apply persistent routes")
    init.add_argument("--base-domain")
    init.add_argument("--from-env-file")
    add_no_apply(init)
    init.set_defaults(handler=command_init)
    publish = commands.add_parser("publish", help="publish a localhost port or URL")
    publish.add_argument("target", help="port, or http(s)://localhost:port")
    add_no_apply(publish)
    publish.set_defaults(handler=command_publish)
    listing = commands.add_parser("list", help="list published routes")
    listing.set_defaults(handler=command_list)
    resolve = commands.add_parser("resolve", help="show one route as JSON")
    resolve.add_argument("route", help="route id, hostname, or URL")
    resolve.set_defaults(handler=command_resolve)
    remove = commands.add_parser("remove", help="remove a route")
    remove.add_argument("route", help="route id, hostname, or URL")
    add_no_apply(remove)
    remove.set_defaults(handler=command_remove)
    apply = commands.add_parser("apply", help="reapply persistent routes to Caddy")
    apply.set_defaults(handler=command_apply)
    validate = commands.add_parser("validate", help="validate registry and generated fragment")
    validate.set_defaults(handler=command_validate)
    return parser


def main() -> int:
    try:
        args = build_parser().parse_args()
        args.handler(args)
        return 0
    except (OSError, ValueError, RuntimeError, KeyError, json.JSONDecodeError) as exc:
        print(f"dev-route: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())

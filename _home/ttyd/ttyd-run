#!/usr/bin/env bash
# Foreground ttyd process supervised by ~/.config/systemd/user/ttyd.service.
# Launches Herdr, which starts or attaches to the persistent session.

set -euo pipefail

PORT="${TTYD_PORT:-7681}"
INTERFACE="${TTYD_INTERFACE:-lo}"
MAX_CLIENTS="${TTYD_MAX_CLIENTS:-1}"
FONT_FAMILY="${TTYD_FONT_FAMILY:-Maple Mono NF CN}"
FONT_SIZE="${TTYD_FONT_SIZE:-16}"
INDEX_PATH="${TTYD_INDEX_PATH:-$HOME/.local/share/ttyd/index.html}"
HERDR_BIN="${TTYD_HERDR_BIN:-$(command -v herdr || printf '%s' "$HOME/.local/bin/herdr")}"

command -v ttyd >/dev/null || {
  echo "ttyd not found in PATH." >&2
  exit 1
}

if [[ ! -x "$HERDR_BIN" ]]; then
  echo "Herdr binary not found at '$HERDR_BIN'." >&2
  exit 1
fi

if [[ ! -r "$INDEX_PATH" ]]; then
  echo "Custom ttyd client not found at '$INDEX_PATH'." >&2
  echo "Build it with: cd ~/ttyd && just ttyd-build" >&2
  exit 1
fi

if ! ip link show "$INTERFACE" >/dev/null 2>&1; then
  echo "Network interface '$INTERFACE' is not available." >&2
  exit 1
fi

# Serve Herdr on loopback only. It is published to the tailnet as the named
# Caddy route `herdr` (`dev-route set herdr 7681`), which owns TLS. No
# credentials are configured here: access is restricted by Caddy binding and
# the tailnet ACLs/grants.
exec ttyd \
  -p "$PORT" \
  -i "$INTERFACE" \
  -O \
  -W \
  -m "$MAX_CLIENTS" \
  -I "$INDEX_PATH" \
  -t "rendererType=canvas" \
  -t "fontFamily=$FONT_FAMILY" \
  -t "fontSize=$FONT_SIZE" \
  -t "titleFixed=Herdr" \
  -s 1 \
  -- "$HERDR_BIN"

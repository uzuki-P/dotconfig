[
    {
        "key": "ctrl+h",
        "command": "workbench.action.navigateLeft",
        "when": "!terminalFocus && !whichkeyVisible && ((editorTextFocus && vim.mode == 'Normal') || (!editorTextFocus && !inputFocus))"
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.navigateRight",
        "when": "!terminalFocus && !whichkeyVisible && ((editorTextFocus && vim.mode == 'Normal') || (!editorTextFocus && !inputFocus))"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.navigateUp",
        "when": "!terminalFocus && !whichkeyVisible && ((editorTextFocus && vim.mode == 'Normal') || (!editorTextFocus && !inputFocus))"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.navigateDown",
        "when": "!terminalFocus && !whichkeyVisible && ((editorTextFocus && vim.mode == 'Normal') || (!editorTextFocus && !inputFocus))"
    },
    {
        "key": "ctrl+\\",
        "command": "workbench.action.terminal.toggleTerminal"
    },
    {
        "key": "ctrl+b",
        "command": "workbench.action.toggleSidebarVisibility"
    },
    {
        "key": "a",
        "command": "explorer.newFile",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "shift+a",
        "command": "explorer.newFolder",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "r",
        "command": "renameFile",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "d",
        "command": "deleteFile",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "x",
        "command": "filesExplorer.cut",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "c",
        "command": "filesExplorer.copy",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "p",
        "command": "filesExplorer.paste",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "shift+h",
        "command": "workbench.files.action.collapseExplorerFolders",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "q",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "space e",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "alt+enter",
        "command": "editor.action.quickFix",
        "when": "editorTextFocus"
    },
    {
        "key": "-",
        "command": "workbench.files.action.showActiveFileInExplorer",
        "when": "editorTextFocus && vim.mode == 'Normal' && !whichkeyVisible"
    },
    {
        "key": "shift+h",
        "command": "workbench.action.previousEditor",
        "when": "editorTextFocus && vim.mode == 'Normal' && !whichkeyVisible"
    },
    {
        "key": "shift+l",
        "command": "workbench.action.nextEditor",
        "when": "editorTextFocus && vim.mode == 'Normal' && !whichkeyVisible"
    },
    {
        "key": "shift+q",
        "command": "workbench.action.closeActiveEditor",
        "when": "editorTextFocus && vim.mode == 'Normal' && !whichkeyVisible"
    },
    {
        "key": "ctrl+q",
        "command": "workbench.action.closeActiveEditor",
        "when": "editorTextFocus && vim.mode == 'Normal' && !whichkeyVisible"
    },
    {
        "key": "] d",
        "command": "editor.action.marker.next",
        "when": "editorTextFocus && vim.mode == 'Normal' && !whichkeyVisible"
    },
    {
        "key": "[ d",
        "command": "editor.action.marker.prev",
        "when": "editorTextFocus && vim.mode == 'Normal' && !whichkeyVisible"
    },
    {
        "key": "] e",
        "command": "editor.action.marker.next",
        "when": "editorTextFocus && vim.mode == 'Normal' && !whichkeyVisible"
    },
    {
        "key": "[ e",
        "command": "editor.action.marker.prev",
        "when": "editorTextFocus && vim.mode == 'Normal' && !whichkeyVisible"
    },
    {
        "key": "] h",
        "command": "editor.action.dirtydiff.next",
        "when": "editorTextFocus && vim.mode == 'Normal' && !whichkeyVisible"
    },
    {
        "key": "[ h",
        "command": "editor.action.dirtydiff.previous",
        "when": "editorTextFocus && vim.mode == 'Normal' && !whichkeyVisible"
    },
    {
        "key": "space",
        "command": "whichkey.show",
        "when": "!editorTextFocus && !inputFocus && !terminalFocus && !filesExplorerFocus && !whichkeyVisible"
    },
    {
        "key": "s s",
        "command": "workbench.action.gotoSymbol",
        "when": "editorTextFocus && vim.mode == 'Normal' && !whichkeyVisible"
    },
    {
        "key": "s shift+s",
        "command": "workbench.action.showAllSymbols",
        "when": "editorTextFocus && vim.mode == 'Normal' && !whichkeyVisible"
    },
    {
        "key": "ctrl+w h",
        "command": "workbench.action.navigateLeft",
        "when": "!editorTextFocus && !inputFocus && !terminalFocus"
    },
    {
        "key": "ctrl+w l",
        "command": "workbench.action.navigateRight",
        "when": "!editorTextFocus && !inputFocus && !terminalFocus"
    },
    {
        "key": "ctrl+w k",
        "command": "workbench.action.navigateUp",
        "when": "!editorTextFocus && !inputFocus && !terminalFocus"
    },
    {
        "key": "ctrl+w j",
        "command": "workbench.action.navigateDown",
        "when": "!editorTextFocus && !inputFocus && !terminalFocus"
    },
    {
        "key": "o",
        "command": "git.openFile",
        "when": "scmResourceState && !inputFocus"
    },
    {
        "key": "ctrl+shift+g",
        "command": "workbench.view.scm",
        "when": "!terminalFocus"
    }
]

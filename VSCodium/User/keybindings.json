[
    { "key": "ctrl+h", "command": "workbench.action.navigateLeft", "when": "!terminalFocus" },
    { "key": "ctrl+l", "command": "workbench.action.navigateRight", "when": "!terminalFocus" },
    { "key": "ctrl+k", "command": "workbench.action.navigateUp", "when": "!terminalFocus" },
    { "key": "ctrl+j", "command": "workbench.action.navigateDown", "when": "!terminalFocus" },
    { "key": "ctrl+\\", "command": "workbench.action.terminal.toggleTerminal" },
    { "key": "ctrl+b", "command": "workbench.action.toggleSidebarVisibility" },
    { "key": "a", "command": "explorer.newFile", "when": "filesExplorerFocus && !inputFocus" },
    { "key": "shift+a", "command": "explorer.newFolder", "when": "filesExplorerFocus && !inputFocus" },
    { "key": "r", "command": "renameFile", "when": "filesExplorerFocus && !inputFocus" },
    { "key": "d", "command": "deleteFile", "when": "filesExplorerFocus && !inputFocus" },
    { "key": "x", "command": "filesExplorer.cut", "when": "filesExplorerFocus && !inputFocus" },
    { "key": "c", "command": "filesExplorer.copy", "when": "filesExplorerFocus && !inputFocus" },
    { "key": "p", "command": "filesExplorer.paste", "when": "filesExplorerFocus && !inputFocus" },
    { "key": "shift+h", "command": "workbench.files.action.collapseExplorerFolders", "when": "filesExplorerFocus && !inputFocus" },
    { "key": "q", "command": "workbench.action.toggleSidebarVisibility", "when": "filesExplorerFocus && !inputFocus" },
    { "key": "space e", "command": "workbench.action.toggleSidebarVisibility", "when": "filesExplorerFocus && !inputFocus" },
    { "key": "space space", "command": "workbench.action.quickOpen", "when": "!inputFocus && !terminalFocus && (!editorTextFocus || vim.mode == 'Normal')" },
    { "key": "space f f", "command": "workbench.action.quickOpen", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space f p", "command": "workbench.action.openRecent", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space f p", "command": "workbench.action.openRecent", "when": "!editorIsOpen && !inputFocus && !terminalFocus" },
    { "key": "space f g", "command": "workbench.action.findInFiles", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space /", "command": "workbench.action.findInFiles", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space s g", "command": "workbench.action.findInFiles", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space s b", "command": "actions.find", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space s w", "command": "editor.action.wordHighlight.trigger", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space c a", "command": "editor.action.quickFix", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space .", "command": "editor.action.quickFix", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "alt+enter", "command": "editor.action.quickFix", "when": "editorTextFocus" },
    { "key": "space c r", "command": "editor.action.rename", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space c f", "command": "editor.action.formatDocument", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space x x", "command": "workbench.actions.view.problems", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space t i", "command": "editor.action.toggleInlayHints", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space u w", "command": "editor.action.toggleWordWrap", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space m p", "command": "markdown.showPreview", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space m shift+p", "command": "markdown.showPreviewToSide", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space e", "command": "workbench.files.action.showActiveFileInExplorer", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "-", "command": "workbench.files.action.showActiveFileInExplorer", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "shift+h", "command": "workbench.action.previousEditor", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "shift+l", "command": "workbench.action.nextEditor", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "shift+q", "command": "workbench.action.closeActiveEditor", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "ctrl+q", "command": "workbench.action.closeActiveEditor", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space b d", "command": "workbench.action.closeActiveEditor", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space b o", "command": "workbench.action.closeOtherEditors", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "] d", "command": "editor.action.marker.next", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "[ d", "command": "editor.action.marker.prev", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "] e", "command": "editor.action.marker.next", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "[ e", "command": "editor.action.marker.prev", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "] h", "command": "editor.action.dirtydiff.next", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "[ h", "command": "editor.action.dirtydiff.previous", "when": "editorTextFocus && vim.mode == 'Normal'" },
    { "key": "space g s", "command": "workbench.view.scm", "when": "editorTextFocus && vim.mode == 'Normal'" }
]

#!/usr/bin/env bash
set -euo pipefail

if [[ $# != 4 ]]; then
    echo "Usage: install-appimage APPIMAGE APP_ID DISPLAY_NAME ICON_PNG" >&2
    exit 2
fi
source_file=$1
app_id=$2
display_name=$3
icon_source=$4
[[ -f "$source_file" && "$source_file" == *.AppImage ]] || { echo "AppImage not found" >&2; exit 1; }
[[ -f "$icon_source" && "$icon_source" == *.png ]] || { echo "Launcher PNG not found" >&2; exit 1; }
[[ "$app_id" =~ ^[a-z0-9][a-z0-9.-]*$ ]] || { echo "Invalid app identifier" >&2; exit 2; }
[[ -n "$display_name" && "$display_name" != *$'\n'* && "$display_name" != *$'\r'* ]] || { echo "Invalid display name" >&2; exit 2; }

apps_dir=${APPIMAGE_APPS_DIR:-$HOME/apps}
data_dir=${APPIMAGE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}}
mkdir -p "$apps_dir" "$data_dir/applications" "$data_dir/icons/hicolor/512x512/apps"
apps_dir=$(cd "$apps_dir" && pwd)
target="$apps_dir/$app_id.AppImage"
[[ "$target" != *$'\n'* && "$target" != *$'\r'* ]] || { echo "Invalid installation path" >&2; exit 2; }
temporary=$(mktemp "$apps_dir/.$app_id.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT
cp -- "$source_file" "$temporary"
chmod 755 "$temporary"
mv -f -- "$temporary" "$target"
cp -- "$icon_source" "$data_dir/icons/hicolor/512x512/apps/$app_id.png"

# Escape the Desktop Entry string layer and quoted Exec argument layer.
exec_path=${target//\\/\\\\\\\\}
exec_path=${exec_path//\"/\\\\\"}
exec_path=${exec_path//\$/\\\\\$}
exec_path=${exec_path//\`/\\\\\`}
exec_path=${exec_path//%/%%}
desktop_name=${display_name//\\/\\\\}
cat > "$data_dir/applications/$app_id.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$desktop_name
Exec=env -u LD_LIBRARY_PATH "$exec_path"
Terminal=false
Categories=Utility;
Icon=$app_id
StartupWMClass=$app_id
EOF

printf 'Installed: %s\nLauncher: %s\n' "$target" "$data_dir/applications/$app_id.desktop"
